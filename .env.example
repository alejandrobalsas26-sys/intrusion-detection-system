# ============================================================================
# TEMPLATE — safe to commit. Copy to .env and fill in real values locally.
# .env itself is gitignored and must NEVER be committed.
# ============================================================================

# --- Email Alerting (SMTP) ---
EMAIL_SENDER=your_sender_email@example.com
EMAIL_PASSWORD=your_app_password_here
ALERT_RECEIVER=security_admin@example.com
DB_PATH=./logs/ids_database.sqlite3
FAILSAFE_LOG_PATH=./logs/failsafe.log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Network Sensor (L2) Configuration ---
# EXPLICIT CONSENT REQUIRED: Set to 'true' to acknowledge legal responsibility for network scanning
NETWORK_MONITOR_CONSENT=false
ARP_SPOOF_MAX_CHANGES=1
ARP_SPOOF_WINDOW_MINUTES=5
SYN_SCAN_THRESHOLD=20
SYN_SCAN_WINDOW_SECONDS=10

# --- Authentication & MFA (L7) ---
# Generate a valid 32-byte URL-safe base64 key using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=your_fernet_key_here
MFA_RECOVERY_CODES_COUNT=10
# Rate Limiting (Exponential Backoff)
MFA_BACKOFF_BASE_DELAY_SECONDS=1
MFA_BACKOFF_MAX_DELAY_SECONDS=60
MFA_BACKOFF_WINDOW_SECONDS=300
MFA_BACKOFF_ALERT_THRESHOLD=5

# Backoff strategy: 'sleep' (legacy, serializes the caller) or 'reject'
# (non-blocking, returns RATE_LIMITED immediately — recommended for web).
# The dashboard defaults to 'reject' on its own; set explicitly to override.
#MFA_BACKOFF_MODE=reject

# --- Dashboard (L8) Configuration ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_64_character_hex_secret_here
FLASK_ENV=development
# HTTP login rate limit (fixed window per client IP)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Server-Sent Events stream bounds
SSE_MAX_LIFETIME_SECONDS=900
SSE_POLL_INTERVAL_SECONDS=5
# Max request body accepted by the dashboard (bytes). Defaults to 64 KiB.
#MAX_CONTENT_LENGTH_BYTES=65536
# Optional bearer token to protect /metrics. When unset, /metrics is public
# (probe/scraper friendly). When set, scrapers must send
# "Authorization: Bearer <token>".
#METRICS_TOKEN=

# --- Detection Engine (correlation) ---
CORRELATION_BRUTE_FORCE_THRESHOLD=5
CORRELATION_BRUTE_FORCE_WINDOW_SECONDS=300
CORRELATION_CHAIN_WINDOW_SECONDS=1800
# Password spray: failures against >= N distinct users within the window
CORRELATION_PASSWORD_SPRAY_USER_THRESHOLD=5
CORRELATION_PASSWORD_SPRAY_WINDOW_SECONDS=300
# Successful login after >= N failures for the same user within the window
CORRELATION_SUCCESS_AFTER_FAILURES_THRESHOLD=5
CORRELATION_SUCCESS_AFTER_FAILURES_WINDOW_SECONDS=600

# --- Threat intelligence / IOC watchlists (optional, local-only) ---
# Plain-text files: one indicator per line, '#' for comments. Off unless set.
# IP list accepts IPv4/IPv6 addresses and CIDR ranges; domain list matches a
# listed parent against its subdomains. No cloud/API/paid feeds involved.
#IOC_IP_LIST_PATH=./intel/malicious_ips.txt
#IOC_DOMAIN_LIST_PATH=./intel/malicious_domains.txt
# Suppress duplicate sensor events for N seconds (0 = off, legacy behavior)
EVENT_DEDUP_WINDOW_SECONDS=0

# --- Alerts (L1) ---
# Suppress duplicate alert e-mails for N seconds (0 = off, legacy behavior)
ALERT_DEDUP_WINDOW_SECONDS=0

# --- Database retention ---
RETENTION_DAYS=90

# --- AI assistance (optional, local-first; disabled unless set) ---
# AI_BACKEND=ollama
# AI_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# AI_MODEL=llama3.2
# AI_TIMEOUT_SECONDS=20
# Optional SSRF lockdown: comma-separated hostnames the AI client may contact.
# Leave unset to trust AI_ENDPOINT as-is; set e.g. "127.0.0.1,localhost" to pin.
# AI_ALLOWED_HOSTS=127.0.0.1,localhost

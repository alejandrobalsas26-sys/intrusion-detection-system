EMAIL_SENDER=your_sender_email@example.com
EMAIL_PASSWORD=your_app_password_here
ALERT_RECEIVER=security_admin@example.com
DB_PATH=./logs/ids_database.sqlite3
FAILSAFE_LOG_PATH=./logs/failsafe.log 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# --- Network Sensor (L2) Configuration ---
# EXPLICIT CONSENT REQUIRED: Set to 'true' to acknowledge legal responsibility for network scanning
NETWORK_MONITOR_CONSENT=false

# ARP Spoofing Thresholds
ARP_SPOOF_MAX_CHANGES=1
ARP_SPOOF_WINDOW_MINUTES=5

# SYN Scan Thresholds
SYN_SCAN_THRESHOLD=20
SYN_SCAN_WINDOW_SECONDS=10
# --- Authentication & MFA (L7) ---
# Generate a valid 32-byte URL-safe base64 key using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=your_fernet_key_here

MFA_BACKOFF_THRESHOLD=5
MFA_RECOVERY_CODES_COUNT=10
# MFA & Identity Configuration
MFA_ENCRYPTION_KEY=tu_fernet_key_aqui
MFA_BACKOFF_THRESHOLD=5
